# === Модели ===
# Ollama-теги; изменить, если установлены другие версии
CHAT_MODEL=qwen3-8b-abliterated-v2
CHAT_MODEL_FALLBACK=dolphin3-llama3.1-8b
VISION_MODEL=qwen2.5vl:7b
EMBED_MODEL=nomic-embed-text

# === Контекст ===
CONTEXT_SIZE=4096
# Расширенный режим (осторожно: больше VRAM)
# CONTEXT_SIZE=8192

# === Генерация ===
TEMPERATURE=0.8
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1
MAX_TOKENS=600

# === Память ===
AUTO_MEMORY=true
# Максимальное количество чанков памяти в контексте
MEMORY_MAX_CHUNKS=5
# Размер чанка (символы)
MEMORY_CHUNK_SIZE=500
MEMORY_CHUNK_OVERLAP=50

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chatbot_memory

# === Ollama ===
OLLAMA_BASE_URL=http://ollama:11434

# === Сервисы ===
BACKEND_PORT=8000
WEBUI_PORT=3000

# === Персонаж ===
CHARACTER_ID=default
USER_ID=default_user
